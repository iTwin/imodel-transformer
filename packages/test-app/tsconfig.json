{
  "extends": "./node_modules/@itwin/build-tools/tsconfig-base.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "outDir": "./lib",
    "rootDir": "./src",
    "esModuleInterop": true,
    "module": "CommonJS",
    "moduleResolution": "Bundler",
    "resolvePackageJsonExports": false,
    "types": ["node", "mocha"]
  },
  "include": ["./src/**/*.ts"]
}
