{
  "name": "transformer-performance-tests",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "scripts": {
    "build:profiler": "pnpm --dir ../performance-scripts build",
    "build": "pnpm build:profiler && tsc --noEmit --incremental false 1>&2",
    "build:quick-cli": "pnpm build:profiler && node ../../scripts/rm.js test/quick/runtime/.compiled && tsc -p tsconfig.quick-cli.json 1>&2",
    "clean": "node ../../scripts/rm.js lib test/quick/runtime/.compiled",
    "lint": "pnpm build:profiler && eslint \"./test/**/*.ts\" 1>&2",
    "test": "pnpm build:profiler && vitest run",
    "format": "prettier \"./test/**/*.ts\" --write",
    "test:quick-unit": "pnpm build:profiler && vitest run --config vitest.quick.config.ts tests/unit",
    "test:quick-comparison": "pnpm build:profiler && vitest run --config vitest.quick.config.ts test/quick/tests/unit/ComparisonReport.test.ts test/quick/tests/unit/ComparisonRunner.test.ts",
    "test:quick-integration": "pnpm build:profiler && vitest run --config vitest.quick.config.ts tests/integration",
    "test:quick-harness": "pnpm build:profiler && vitest run --config vitest.quick.config.ts tests",
    "test:quick": "pnpm build:profiler && vitest run --config vitest.quick.config.ts QuickPerformance.test.ts",
    "quick:profile": "pnpm build:quick-cli && node test/quick/runtime/.compiled/quick/src/cli/profileCli.js",
    "quick:build-fixture": "pnpm build:quick-cli && node test/quick/runtime/.compiled/quick/src/cli/fixtureCli.js build-fixture",
    "quick:verify-fixture": "pnpm build:quick-cli && node test/quick/runtime/.compiled/quick/src/cli/fixtureCli.js verify-fixture",
    "quick:compare": "pnpm build:quick-cli && node test/quick/runtime/.compiled/quick/src/cli/comparisonCli.js",
    "process-reports": "node scripts/process-reports"
  },
  "repository": {},
  "dependencies": {
    "@bentley/hook-profiler": "workspace:*",
    "@itwin/core-backend": "catalog:",
    "@itwin/core-bentley": "catalog:",
    "@itwin/core-common": "catalog:",
    "@itwin/core-geometry": "catalog:",
    "@itwin/core-quantity": "catalog:",
    "@itwin/ecschema-metadata": "catalog:",
    "@itwin/imodel-transformer": "workspace:*",
    "@itwin/imodel-transformer-test-utils": "workspace:*",
    "@itwin/imodels-access-backend": "catalog:",
    "@itwin/imodels-access-common": "catalog:",
    "@itwin/imodels-client-authoring": "catalog:",
    "@itwin/node-cli-authorization": "catalog:",
    "@itwin/object-storage-azure": "catalog:",
    "@itwin/perf-tools": "^4.10.12"
  },
  "devDependencies": {
    "@itwin/build-tools": "catalog:",
    "@itwin/oidc-signin-tool": "^6.0.0",
    "@itwin/service-authorization": "^2.1.2",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
