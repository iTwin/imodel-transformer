{
  "name": "@bentley/hook-profiler",
  "version": "1.0.0",
  "private": true,
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./js-cpu": {
      "types": "./lib/runWithJsCpuProfile.d.ts",
      "require": "./lib/runWithJsCpuProfile.js",
      "default": "./lib/runWithJsCpuProfile.js"
    },
    "./cleanup": {
      "types": "./lib/runWithCleanup.d.ts",
      "require": "./lib/runWithCleanup.js",
      "default": "./lib/runWithCleanup.js"
    },
    "./pause": {
      "types": "./lib/runWithPause.d.ts",
      "require": "./lib/runWithPause.js",
      "default": "./lib/runWithPause.js"
    }
  },
  "description": "Scripts for profiling performance of JavaScript (iTwin.js) applications",
  "bin": {
    "linux-syscall-perf": "./bin/linux-syscall-perf.sh",
    "linux-resource-usage": "./bin/linux-resource-usage.sh"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "echo \"Error: no tests\" && exit 0"
  },
  "keywords": [
    "performance",
    "profiling"
  ],
  "author": "Bentley Systems, Inc.",
  "license": "MIT",
  "devDependencies": {
    "@itwin/build-tools": "catalog:",
    "@itwin/core-backend": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
