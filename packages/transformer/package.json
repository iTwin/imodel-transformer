{
  "name": "@itwin/imodel-transformer",
  "version": "2.0.0-dev.64",
  "description": "API for exporting an iModel's parts and also importing them into another iModel",
  "main": "lib/cjs/imodel-transformer.js",
  "typings": "lib/cjs/imodel-transformer.d.ts",
  "typesVersions": {
    "*": {
      "schema-processing": [
        "lib/cjs/schema-processing.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./lib/cjs/imodel-transformer.d.ts",
      "require": "./lib/cjs/imodel-transformer.js",
      "default": "./lib/cjs/imodel-transformer.js"
    },
    "./schema-processing": {
      "types": "./lib/cjs/schema-processing.d.ts",
      "require": "./lib/cjs/schema-processing.js",
      "default": "./lib/cjs/schema-processing.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || ^24.18.0"
  },
  "scripts": {
    "build": "npm run -s typecheck && npm run -s build:cjs && npm run -s extract-api",
    "build:cjs": "tsc -p tsconfig.build.json 1>&2 --outDir lib/cjs",
    "clean": "node ../../scripts/rm.js lib",
    "docs": "npm run -s docs:extract && npm run -s docs:reference && npm run -s docs:changelog",
    "docs:changelog": "node scripts/copyChangelog.js",
    "# env var is workaround, need to contribute a better rush-less root-package.json detector to betools": "",
    "docs:reference": "cross-env RUSHSTACK_FILE_ERROR_BASE_FOLDER='../..' betools docs --includes=../../build/docs/extract --json=../../build/docs/reference/imodel-transformer/file.json --tsIndexFile=imodel-transformer.ts --onlyJson",
    "docs:extract": "betools extract --fileExt=ts --extractFrom=./src/test --recursive --out=../../build/docs/extract",
    "cover": "vitest run --coverage",
    "extract-api": "npm run -s extract-api:root && npm run -s extract-api:schema-processing",
    "extract-api:root": "betools extract-api --entry=imodel-transformer --apiReportFolder=../../common/api --apiReportTempFolder=../../common/api/temp --apiSummaryFolder=../../common/api/summary",
    "extract-api:schema-processing": "betools extract-api --entry=schema-processing --apiReportFolder=../../common/api --apiReportTempFolder=../../common/api/temp --apiSummaryFolder=../../common/api/summary",
    "lint": "eslint --quiet \"./src/**/*.ts\" 1>&2",
    "lint:no-tests": "eslint --quiet \"./src/*.ts\" 1>&2",
    "lint:fix": "eslint --fix --quiet \"./src/**/*.ts\" 1>&2",
    "format": "prettier \"./src/**/*.ts\" --write",
    "lint:with-warnings": "eslint \"./src/**/*.ts\" 1>&2",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental false 1>&2",
    "no-internal-report": "no-internal-report src/**/*.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iTwin/imodel-transformer.git",
    "directory": "packages/transformer"
  },
  "keywords": [
    "Bentley",
    "BIM",
    "iModel",
    "digital-twin",
    "iTwin"
  ],
  "author": {
    "name": "Bentley Systems, Inc.",
    "url": "http://www.bentley.com"
  },
  "//deps": [
    "SEE file://./README.md#versioning",
    "This package relies on @internal APIs in iTwin.js, and therefore has very strict peerDep versions",
    "We perform a version check at runtime to ensure this.",
    "Every new iTwin.js version must be validated, and fixes are rarely ported to old versions.",
    "Removing Dependencies on internal APIs is ongoing."
  ],
  "peerDependencies": {
    "@itwin/core-backend": "^5.13.0",
    "@itwin/core-bentley": "^5.13.0",
    "@itwin/core-common": "^5.13.0",
    "@itwin/core-geometry": "^5.13.0",
    "@itwin/core-quantity": "^5.13.0",
    "@itwin/ecschema-editing": "^5.13.0",
    "@itwin/ecschema-locaters": "^5.13.0",
    "@itwin/ecschema-metadata": "^5.13.0"
  },
  "peerDependenciesMeta": {
    "@itwin/ecschema-editing": {
      "optional": true
    },
    "@itwin/ecschema-locaters": {
      "optional": true
    }
  },
  "//devDependencies": [
    "NOTE: All peerDependencies should also be listed as devDependencies since peerDependencies are not considered by npm install",
    "NOTE: All tools used by scripts in this package must be listed as devDependencies, except ESLint and Prettier tooling, which the workspace root declares"
  ],
  "devDependencies": {
    "@itwin/build-tools": "catalog:",
    "@itwin/core-backend": "catalog:",
    "@itwin/core-bentley": "catalog:",
    "@itwin/core-common": "catalog:",
    "@itwin/core-geometry": "catalog:",
    "@itwin/core-quantity": "catalog:",
    "@itwin/ecschema-editing": "catalog:",
    "@itwin/ecschema-locaters": "catalog:",
    "@itwin/ecschema-metadata": "catalog:",
    "@itwin/imodel-transformer-test-utils": "workspace:*",
    "@types/node": "catalog:",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-v8": "4.1.10",
    "cross-env": "^5.2.1",
    "@typescript/native": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "semver": "^7.7.2"
  }
}
